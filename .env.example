# Copy to .env and adjust as needed.

PORT=7272

# Optional override; if omitted, compose uses $USER from your shell.
USERNAME=

POSTGRES_DB=jupiter
POSTGRES_USER=jupiter
POSTGRES_PASSWORD=jupiter

# Default persistent database directory used by compose.
POSTGRES_DATA_DIR=./.data/postgres

# Optional host path overrides. If you set them, use absolute paths.
# Omit them to use Compose defaults: ${HOME}/developer and ${HOME}/.ssh.
# HOST_DEVELOPER_DIR=/home/your-user/developer
# HOST_SSH_DIR=/home/your-user/.ssh

# Optional OpenAI API key.
OPENAI_API_KEY=
