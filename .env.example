# Copy to .env and adjust as needed.

PORT=7272

# Required: stable 32-byte Base64 key for application database encryption.
# Generate with: openssl rand -base64 32
# Docker/Compose may provide this to the entrypoint; it strips and pipes it once to Java stdin.
# Native launches must use env -u JUPITER_ENCRYPTION_KEY and pipe the key; never launch the JVM with it in env/args.
JUPITER_ENCRYPTION_KEY=

# Optional HTTP Basic auth. A nonblank password enables auth; username defaults to jupiter.
JUPITER_HTTP_AUTH_PASSWORD=
JUPITER_HTTP_AUTH_USERNAME=jupiter

# Optional OpenAI API key.
OPENAI_API_KEY=
